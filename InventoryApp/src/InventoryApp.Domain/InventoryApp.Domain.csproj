<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>InventoryApp.Domain</RootNamespace>
  </PropertyGroup>

  <!--
    The Domain layer deliberately references only the abstracted Identity
    *stores* package rather than the whole ASP.NET Core framework. That keeps
    the entity layer free of web-framework concerns while still letting
    ApplicationUser inherit IdentityUser.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="8.0.31" />
  </ItemGroup>

</Project>
