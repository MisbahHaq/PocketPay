<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>InventoryApp.API</RootNamespace>
    <!-- WebApplicationFactory<T> is the usual way to test an API; this solution
         hosts the real pipeline in-process instead, so this stays false. -->
    <UserSecretsId>inventoryapp-api-8f2c1a4d</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Swagger UI. Required by the brief; the only addition to the allowed list. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InventoryApp.Application\InventoryApp.Application.csproj" />
    <ProjectReference Include="..\InventoryApp.Infrastructure\InventoryApp.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InventoryApp.Tests" />
  </ItemGroup>

</Project>
