<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>InventoryApp.Application</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Identity *Core* (UserManager / password hashing / role APIs) is enough for
      the application layer. No EF Core, no ASP.NET Core.
    -->
    <PackageReference Include="FluentValidation" Version="11.11.0" />
    <!-- Official DI companion of FluentValidation: supplies AddValidatorsFromAssembly. -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="8.0.31" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\InventoryApp.Domain\InventoryApp.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InventoryApp.Tests" />
  </ItemGroup>

</Project>
