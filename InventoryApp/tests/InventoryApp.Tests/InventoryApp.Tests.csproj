<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>InventoryApp.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- SQLite in-memory gives the integration tests real relational SQL
         without needing a database server. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\InventoryApp.API\InventoryApp.API.csproj" />
    <ProjectReference Include="..\..\src\InventoryApp.Application\InventoryApp.Application.csproj" />
    <ProjectReference Include="..\..\src\InventoryApp.Domain\InventoryApp.Domain.csproj" />
    <ProjectReference Include="..\..\src\InventoryApp.Infrastructure\InventoryApp.Infrastructure.csproj" />
  </ItemGroup>

</Project>
