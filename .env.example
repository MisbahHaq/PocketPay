# Copy this file to .env and adjust values as needed.
# .env is gitignored - never commit real credentials.
POSTGRES_USER=paypocket
POSTGRES_PASSWORD=paypocket_dev_password
POSTGRES_DB=paypocket
# Host port for Postgres. 5432/5433 may be taken by locally installed
# PostgreSQL services - bump this if the container stays unhealthy.
POSTGRES_PORT=5434

# --- Application secrets (optional, development) -----------------------------
# The API reads these from environment variables or user-secrets, never from
# this file directly (this file only documents them; .env feeds Docker Compose).
#
# JWT signing key: required, at least 32 characters. Generate one with:
#   openssl rand -hex 32
# Set it locally with:
#   dotnet user-secrets set "Jwt:SigningKey" "<key>" --project src/WalletPlatform.Api
Jwt__SigningKey=

# Optional admin bootstrap; when both are set the API seeds an Admin account on
# startup. Password must satisfy the password policy (8+ chars, upper, lower,
# digit, non-alphanumeric). Seeding is skipped when either value is absent.
SeedAdmin__Email=
SeedAdmin__Password=
