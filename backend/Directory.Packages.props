<Project>

  <!--
    Central Package Management.

    Why: with six projects it is trivial for the same dependency to drift to two
    different versions, which is the classic source of NuGet "assembly version
    conflict" runtime failures (especially across EF Core, Serilog and the
    Microsoft.Extensions.* family). One version per package, declared once.

    Everything is pinned to the latest service release of the .NET 8 line. We
    deliberately do NOT float (no "8.*") because reproducible builds are a
    prerequisite for trustworthy CI.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Shared">
    <PackageVersion Include="MediatR" Version="12.5.0" />
    <PackageVersion Include="FluentValidation" Version="11.12.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.12.0" />
    <PackageVersion Include="Riok.Mapperly" Version="3.6.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="8.0.2" />
    <!-- Identity is split across two primitives-only packages. Both are safe for Domain
         and Application to reference because neither brings an ORM or web hosting:
           .Core   - UserManager, RoleManager, PasswordHasher, validators
           .Stores - the IdentityUser / IdentityRole entity types themselves
         Only Microsoft.AspNetCore.Identity.EntityFrameworkCore (referenced by
         Infrastructure alone) is the one that touches EF Core. -->
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="8.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure">
    <!-- EF Core and its satellite packages are pinned as a set: Npgsql 8.0.11 is
         built against EF Core 8.0.11, and a mismatch surfaces as MissingMethodException
         at model-build time rather than at compile time. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <!-- Maps C# PascalCase properties to snake_case identifiers, which is the
         PostgreSQL convention and lets table/column names be written unquoted in
         hand-written SQL. -->
    <PackageVersion Include="EFCore.NamingConventions" Version="8.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="8.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup Label="Api">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <!-- Pinned to the version JwtBearer 8.0.11 itself resolves. Both the token issuer
         (Infrastructure) and the bearer handler (Api) must compile against the SAME
         Microsoft.IdentityModel stack; a mismatch surfaces as an opaque
         "IDX10500 signature validation failed" at runtime, not at build time. -->
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="7.1.2" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageVersion Include="Asp.Versioning.Mvc" Version="8.1.1" />
    <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="8.1.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="8.0.4" />
  </ItemGroup>

  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Pinned to 7.x on purpose: FluentAssertions 8.x moved to a commercial licence
         for non-open-source use. 7.x is Apache-2.0 and safe for a commercial product. -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="3.10.0" />
  </ItemGroup>

</Project>