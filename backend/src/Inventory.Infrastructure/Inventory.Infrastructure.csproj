<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Inventory.Infrastructure - all the technology that is allowed to change.

    EF Core mapping, Npgsql specifics, JWT issuance, Identity stores, seeding.
    Nothing above this project should ever need to reference a DbContext type.
  -->

  <PropertyGroup>
    <RootNamespace>Inventory.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Infrastructure hosts the DbContext, the startup seeder and the ambient
         current-user accessor, so it needs the ASP.NET Core shared framework. This is
         a single deployable app, not a class library consumed by others, so the extra
         coupling costs nothing that matters. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inventory.Application\Inventory.Application.csproj" />
    <ProjectReference Include="..\Inventory.Domain\Inventory.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time tooling only (dotnet ef migrations). Never ships to runtime. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Inventory.UnitTests" />
    <InternalsVisibleTo Include="Inventory.IntegrationTests" />
  </ItemGroup>

</Project>