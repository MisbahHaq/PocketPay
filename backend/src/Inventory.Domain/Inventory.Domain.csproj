<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Inventory.Domain - the innermost layer.

    Rule of thumb for this project: no persistence, no web, no serialization.
    It must never reference EF Core, ASP.NET Core hosting, or a database driver,
    because every one of those would drag infrastructure decisions into the part of
    the system that holds the business rules.

    The single, narrow framework dependency is Microsoft.Extensions.Identity.Stores,
    for the IdentityUser base class. That package is deliberately chosen because it
    contains only entity types and store contracts - no ORM, no web hosting. If a rule
    here ever needs to "save" or "return HTTP", it belongs in Application or
    Infrastructure instead.
  -->

  <PropertyGroup>
    <RootNamespace>Inventory.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" />
  </ItemGroup>

</Project>