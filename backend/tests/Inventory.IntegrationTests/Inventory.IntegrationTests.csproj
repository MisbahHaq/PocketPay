<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Integration tests boot the real Program.cs through WebApplicationFactory and
    talk to a genuine PostgreSQL instance. A throwaway database is created per
    run (see Support/PostgresFixture) rather than sharing one, so a test that
    writes data cannot make another test flaky.

    Using the real database - not SQLite or the in-memory provider - matters here
    because the behaviours most worth protecting in an inventory system
    (optimistic concurrency via xmin, transactional stock writes, unique index
    violations) are all things a substitute provider silently ignores.
  -->

  <PropertyGroup>
    <RootNamespace>Inventory.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Inventory.Api\Inventory.Api.csproj" />
    <ProjectReference Include="..\..\src\Inventory.Infrastructure\Inventory.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>